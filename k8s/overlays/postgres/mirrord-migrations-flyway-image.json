{
  "operator": true,
  "target": {
    "path": {
      "pod": "pg-server-env-val"
    },
    "namespace": "test-mirrord"
  },
  "feature": {
    "env": true,
    "fs": "local",
    "network": {
      "incoming": "off",
      "outgoing": true
    },
    "db_branches": [
      {
        "id": "pg-migrations-flyway-image",
        "name": "migrations_branch",
        "type": "pg",
        "version": "17",
        "ttl_secs": 600,
        "creation_timeout_secs": 120,
        "connection": {
          "url": "DATABASE_URL"
        },
        "copy": {
          "mode": "empty"
        },
        "migrations": {
          "flavor": "flyway",
          "image": "mirrord-flyway-baked:local",
          "locations": ["filesystem:/flyway/sql-baked"]
        }
      }
    ]
  }
}
