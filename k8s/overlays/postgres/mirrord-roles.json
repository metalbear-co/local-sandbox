{
  "operator": true,
  "target": {
    "path": {
      "pod": "pg-server-roles"
    },
    "namespace": "test-mirrord"
  },
  "feature": {
    "env": true,
    "fs": "local",
    "network": {
      "incoming": "off",
      "outgoing": true
    },
    "db_branches": [
      {
        "id": "pg-roles-branch-{{ key }}",
        "name": "source_db",
        "type": "pg",
        "version": "17",
        "ttl_secs": 600,
        "creation_timeout_secs": 90,
        "connection": {
          "type": "env",
          "params": {
            "host": "DB_HOST",
            "port": "DB_PORT",
            "user": "DB_USER",
            "password": "DB_PASSWORD",
            "database": "DB_NAME"
          }
        },
        "copy": {
          "mode": "all"
        }
      }
    ]
  }
}
